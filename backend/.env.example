# Local SQLite database file. Created automatically if missing.
DB_PATH=lumina.db

# Directory holding the built frontend (frontend/dist). If absent, the
# server runs API-only.
STATIC_DIR=./public

PORT=3000

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# The address that is granted admin rights when it signs up.
ADMIN_EMAIL=admin@lumina.com

# Only needed for the Vite dev server; production is same-origin.
ALLOWED_ORIGINS=http://localhost:5173
