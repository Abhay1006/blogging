# Required: a random string of at least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Local SQLite database file. Created automatically if missing.
DB_PATH=lumina.db

# Directory holding the built frontend (frontend/dist). If absent, the
# server runs API-only.
STATIC_DIR=./public

PORT=10000

# The account that signs up with this email becomes an admin. Leave empty for none.
ADMIN_EMAIL=

# Only needed for the Vite dev server; production is same-origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
