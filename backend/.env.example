# Required: a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=

MONGO_URI=mongodb://localhost:27017
DB_NAME=lumina_db
PORT=10000

# The account that signs up with this email becomes an admin. Leave empty for none.
ADMIN_EMAIL=

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
